{
  "name": "zademy-skills",
  "version": "1.2.3",
  "private": true,
  "description": "Matt Pocock's agent skills for real engineering",
  "type": "module",
  "main": ".opencode/plugins/zademy-skills.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/zademy/skills"
  },
  "license": "MIT",
  "scripts": {
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-plugin-version.mjs",
    "check-plugin-version": "node scripts/sync-plugin-version.mjs --check"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.30.0",
    "@earendil-works/pi-coding-agent": "^0.84.1"
  },
  "packageManager": "npm@10.9.4",
  "pi": {
    "extensions": [
      "./.pi/extensions/zademy-skills.ts"
    ],
    "skills": [
      "./skills/engineering",
      "./skills/productivity"
    ]
  }
}
